{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.26.0",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "author": "mblithium",
  "homepage_url": "https://github.com/mblithium/companion-for-kimai",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Companion for Kimai",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_commandOpenPopup__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*timesheet*"
      ],
      "js": [
        "src/content/namespace.js",
        "src/content/i18n.js",
        "src/content/utils.js",
        "src/common/format.js",
        "src/content/api.js",
        "src/content/storage.js",
        "src/common/permissions.js",
        "src/common/theme.js",
        "src/content/combo.js",
        "src/content/kimai.js",
        "src/content/cache.js",
        "src/content/sitegroup.js",
        "src/content/quicktimer.js"
      ],
      "css": [
        "src/common/theme.css",
        "src/common/themes/light.css",
        "src/common/themes/dark.css",
        "src/common/themes/system.css",
        "src/common/themes/dracula.css",
        "src/common/themes/catppuccin.css",
        "src/common/themes/nord.css",
        "src/common/themes/gnome.css",
        "src/common/themes/gruvbox.css",
        "src/content/quicktimer.css",
        "src/content/combo.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_locales/en/messages.json",
        "_locales/pt_BR/messages.json",
        "_locales/fr/messages.json",
        "_locales/ro/messages.json",
        "_locales/ja/messages.json"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "companion-for-kimai@mblithium",
      "strict_min_version": "121.0"
    }
  }
}
